@article{lu_quantum_2024,
	title = {Quantum financing system: {A} survey on quantum algorithms, potential scenarios and open research issues},
	volume = {41},
	issn = {2452-414X},
	shorttitle = {Quantum financing system},
	url = {https://www.sciencedirect.com/science/article/pii/S2452414X24001079},
